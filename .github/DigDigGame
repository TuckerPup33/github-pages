<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Play DigDig.io</title>
    <style>
        body {
            text-align: center;
            font-family: Arial, sans-serif;
            background-color: #121212;
            color: white;
        }
        iframe {
            width: 80%;
            height: 500px;
            border: none;
            margin-top: 20px;
        }
        .play-button {
            background-color: #ff6600;
            color: white;
            padding: 15px 30px;
            text-decoration: none;
            font-size: 20px;
            border-radius: 10px;
            display: inline-block;
            margin-top: 20px;
        }
    </style>
</head>
<body>

    <h1>Welcome to DigDig.io</h1>
    <p>Play DigDig.io directly from your browser below!</p>

    <!-- Embedded game -->
    <iframe src="https://digdig.io"></iframe>

    <br>

    <a href="https://digdig.io" class="play-button" target="_blank">Play in Fullscreen</a>

</body>
</html>
